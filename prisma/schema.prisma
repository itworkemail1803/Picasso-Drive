// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id // Sẽ dùng ID do Clerk cấp (dạng user_2... để đồng bộ trực tiếp)
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  albums    Album[]
  media     Media[]

  @@map("users")
}

model Album {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  slug        String   @unique
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       Media[]

  @@map("albums")
}

// Bảng Media (ảnh) tạm thời để đây để tạo mối quan hệ, chúng ta sẽ scale chi tiết ở bước sau
model Media {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  albumId      String?  @map("album_id")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  name         String
  url          String   // Đường link publicUrl từ Supabase để hiển thị ảnh
  filePath     String   @map("file_path") // Đường dẫn gốc (ví dụ: uploads/abc.webp) để sau này xóa file trên Supabase
  originalSize Int      @map("original_size")
  storageSize  Int      @map("storage_size") // Dung lượng sau khi nén thực tế lưu trên Cloud
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album        Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@map("media")
}

