generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid()) // Chuyển sang cuid để tương thích tốt với Auth.js
  email         String    @unique
  password      String?    // BẮT BUỘC: Để lưu mật khẩu hash
  name          String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Các quan hệ giữ nguyên
  albums        Album[]
  media         Media[]
  sharedLinks   SharedLink[]

  @@map("users")
}

model Album {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  name        String
  slug        String       @unique
  isPublished Boolean      @default(false) @map("is_published")
  createdAt   DateTime     @default(now()) @map("created_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       Media[]
  sharedLinks SharedLink[]

  @@map("albums")
}

model Media {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  albumId      String?  @map("album_id")
  name         String
  url          String
  filePath     String   @map("file_path")
  originalSize Int      @default(0) @map("original_size")
  size         BigInt   @default(0) @map("storage_size")
  createdAt    DateTime @default(now()) @map("created_at")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  album        Album?   @relation(fields: [albumId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, albumId])
  @@index([userId, createdAt])
  @@index([userId])
  @@map("media")
}

model SharedLink {
  id        String    @id @default(uuid())
  albumId   String    @map("album_id")
  userId    String    @map("user_id")
  label     String?
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  album     Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shared_links")
}
